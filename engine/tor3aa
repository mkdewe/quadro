awk 'function torsion (X1, Y1, Z1, X2, Y2, Z2, X3, Y3, Z3, X4, Y4, Z4) {
             pi = atan2(1,1) * 4;dec2rad=pi/180;rad2dec=180/pi;
             PX = (X1 - X2);PY = (Y1 - Y2);PZ = (Z1 - Z2);
             QX = (X3 - X2);QY = (Y3 - Y2);QZ = (Z3 - Z2);
             RX = (X4 - X2);RY = (Y4 - Y2);RZ = (Z4 - Z2);
             LNX = (QY * RZ) - (QZ * RY);LNY = (QZ * RX) - (QX * RZ);LNZ = (QX * RY) - (QY * RX);
             MNX = (QY * PZ) - (QZ * PY);MNY = (QZ * PX) - (QX * PZ);MNZ = (QX * PY) - (QY * PX);
             ACOS = ((LNX*MNX)+(LNY*MNY)+(LNZ*MNZ))/(((LNX**2+LNY**2+LNZ**2)*(MNX**2+MNY**2+MNZ**2))**(1/2));
             ASIN = (1 - (ACOS**2))**(1/2);
             NUCOS = ((MNX*RX)+(MNY*RY)+(MNZ*RZ))/(((MNX**2+MNY**2+MNZ**2)*(RX**2+RY**2+RZ**2))**(1/2));
             angle = (atan2(ASIN, ACOS)*(180/pi))*(NUCOS/((NUCOS**2)**(1/2)));
            return angle
                                                                        }
     function sugar_parameters (v0, v1, v2, v3, v4) {
             pi = atan2(1,1) * 4;dec2rad=pi/180;rad2dec=180/pi;
             wsp=2.0*(sin(36.0*dec2rad)+sin(72.0*dec2rad));
             num = ((v4 + v1) - (v3 + v0))*dec2rad;
             den = wsp*v2*dec2rad;
             SUGAR_PARAMS[1]=atan2( num, den );
             SUGAR_PARAMS[2]=v2*dec2rad/cos(SUGAR_PARAMS[1]);
             SUGAR_PARAMS[1]=SUGAR_PARAMS[1]*rad2dec
             SUGAR_PARAMS[2]=SUGAR_PARAMS[2]*rad2dec
           return
                                                    }
