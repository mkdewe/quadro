cp t.pdb t.bak
echo "END" >> t.pdb
tor3aa t.pdb > t.tor
awk 'BEGIN{printf "restraints dihedral\n  nassign=500\n" > "t.dih"
          }
{
if(NF==19){li=li+1
  chi=$17;delta=$9;nres=$3;name_res=$4
  at1="O4\047";at2="C1\047"
  if(index("CUTcut",name_res)>0){at3="N1";at4="C2"}else{at3="N9";at4="C4"}
  printf "    assign ( resid %d and name %s )\n",li,at1 > "t.dih"
  printf "           ( resid %d and name %s )\n",li,at2 > "t.dih"
  printf "           ( resid %d and name %s )\n",li,at3 > "t.dih"
  printf "           ( resid %d and name %s ) 20.0 %8.2f 15.0 2\n\n",li,at4,chi > "t.dih"
  at1="C5\047";at2="C4\047";at3="C3\047";at4="O3\047"
  printf "    assign ( resid %d and name %s )\n",li,at1 > "t.dih"
  printf "           ( resid %d and name %s )\n",li,at2 > "t.dih"
  printf "           ( resid %d and name %s )\n",li,at3 > "t.dih"
  printf "           ( resid %d and name %s ) 20.0 %8.2f 15.0 2\n\n",li,at4,delta > "t.dih"
          }
}END{
printf "    scale=1.0\nend\n" > "t.dih"
    }' t.tor
mv t.bak t.pdb
